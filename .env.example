# Copy this file to `.env` and replace every placeholder with values for your environment.
# Do not commit `.env` or a Firebase service-account JSON key.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/powerbuilt
# Optional: retained for tooling that needs an unpooled database connection.
DIRECT_URL=postgresql://user:password@localhost:5432/powerbuilt

# Firebase Admin (server only)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
# Required locally when Application Default Credentials are not already configured.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Firebase Web App (safe to expose to the browser, but use your own project values)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id

# Public contact setting
NEXT_PUBLIC_POWERBUILT_WHATSAPP_NUMBER=your-whatsapp-number
